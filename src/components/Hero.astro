---
/**
 * The first screen: who it is for, the headline, the result in a sentence or
 * two, the button with its one line of reassurance, and the track record.
 * With a photograph (HERO.image) the words sit beside it, the photograph
 * under them on phones.
 */
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Proof from './Proof.astro';
import { HERO, PROOF } from '../data/home';
---

<section class="mx-auto max-w-6xl px-5 pt-12 pb-12 sm:px-8 sm:pt-20 sm:pb-16">
  <div class:list={[HERO.image && 'grid items-center gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-14']}>
    <div>
      {HERO.eyebrow && <p class="eyebrow">{HERO.eyebrow}</p>}
      <h1 class="heading-1 mt-4 max-w-4xl">{HERO.headline}</h1>
      <p class="mt-6 max-w-2xl font-body text-[1.1875rem] leading-relaxed text-muted sm:text-[1.25rem]" set:html={HERO.subheadline} />
      <div class="mt-9">
        <Button />
      </div>
      {HERO.note && <p class="mt-3 max-w-md font-body text-[0.9375rem] leading-relaxed text-muted">{HERO.note}</p>}
    </div>
    {
      HERO.image && (
        <Image src={HERO.image} alt={HERO.alt} widths={[480, 768, 1200]} sizes="(min-width: 1024px) 40vw, 100vw" loading="eager" fetchpriority="high" class="aspect-[4/3] w-full rounded-2xl object-cover lg:aspect-[4/5]" />
      )
    }
  </div>
  {PROOF.length > 0 && <Proof class="mt-12 sm:mt-14" />}
</section>
