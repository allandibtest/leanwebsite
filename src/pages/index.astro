---
/**
 * The home page: one section after another, each fed its words from
 * src/data/home.ts. Reorder the sections, leave out the ones the copy has no
 * words for, or use a kind twice with different words (each needs its own
 * id). The header's links and the button point at these ids.
 */
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import MediaText from '../components/MediaText.astro';
import ServiceCards from '../components/ServiceCards.astro';
import TextBlock from '../components/TextBlock.astro';
import { CONTACT, FORMS, SITE } from '../data/site';
import { ABOUT, CONTACT_SECTION, INTRO, PORTFOLIO, SERVICES } from '../data/home';

const hasForm = Boolean(FORMS.contact);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: CONTACT.email,
  telephone: CONTACT.phone,
  areaServed: ['San Francisco', 'Marin County', 'Alameda County', 'Contra Costa County'],
};
---

<Base title={`${SITE.name} | Maintenance gardening`} description={SITE.description} path="/" jsonLd={jsonLd} hasForm={hasForm}>
  <Hero />
  <TextBlock id="welcome" title={INTRO.title} paragraphs={INTRO.paragraphs} />
  <ServiceCards id="services" title={SERVICES.title} intro={SERVICES.intro} items={SERVICES.items} />
  <Cta class="pb-8" />
  <Gallery id="portfolio" title={PORTFOLIO.title} intro={PORTFOLIO.intro} items={PORTFOLIO.items} />
  <MediaText id="about" title={ABOUT.title} image={ABOUT.image} alt={ABOUT.alt} caption={ABOUT.caption} paragraphs={ABOUT.paragraphs} link={ABOUT.link} />

  <section id="contact" class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-20">
    <div class="panel rounded-2xl px-5 py-12 sm:px-10 sm:py-16">
      <h2 class="heading-2">{CONTACT_SECTION.title}</h2>
      {
        hasForm ? (
          <LeadForm lead={CONTACT_SECTION.lead} suffix="home" split />
        ) : (
          <div class="mt-6 max-w-[42rem]">
            <p class="font-body text-[1.1875rem] leading-relaxed">{CONTACT_SECTION.lead}</p>
            <p class="mt-6 flex flex-wrap gap-3">
              <a href={`mailto:${CONTACT.email}`} class="btn btn-primary btn-lg">
                {CONTACT.email}
              </a>
              {
                CONTACT.phone && (
                  <a href={CONTACT.phoneHref} class="btn btn-ghost btn-lg bg-paper">
                    {CONTACT.phone}
                  </a>
                )
              }
            </p>
          </div>
        )
      }
    </div>
  </section>
</Base>
